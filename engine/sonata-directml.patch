+enum InferenceSession {
+    Concurrent(Session),
+    Serialized(Mutex<Session>),
+}
+
+enum InferenceSessionAccess<'a> {
+    Concurrent(&'a Session),
+    Serialized(MutexGuard<'a, Session>),
+}
+
+impl Deref for InferenceSessionAccess<'_> {
+    type Target = Session;
+
+    fn deref(&self) -> &Self::Target {
+        match self {
+            Self::Concurrent(session) => session,
+            Self::Serialized(session) => session,
+        }
+    }
+}
+
+impl InferenceSession {
+    fn concurrent(session: Session) -> Self {
+        Self::Concurrent(session)
+    }
+
+    fn serialized(session: Session) -> Self {
+        Self::Serialized(Mutex::new(session))
+    }
+
+    fn access(&self) -> InferenceSessionAccess<'_> {
+        match self {
+            Self::Concurrent(session) => InferenceSessionAccess::Concurrent(session),
+            Self::Serialized(session) => InferenceSessionAccess::Serialized(
+                session.lock().unwrap_or_else(|error| error.into_inner()),
+            ),
+        }
+    }
+}
