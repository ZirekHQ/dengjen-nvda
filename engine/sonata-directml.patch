+
+fn accelerator_min_phonemes() -> Option<usize> {
+    let provider = std::env::var("SONATA_EXECUTION_PROVIDER")
+        .unwrap_or_else(|_| "auto".to_string())
+        .to_ascii_lowercase();
+    if provider == "cpu" {
+        return None;
+    }
+    if provider != "auto" && provider != "directml" {
+        log::warn!(
+            "Unknown SONATA_EXECUTION_PROVIDER value `{provider}`; using automatic selection"
+        );
+    }
+    Some(
+        std::env::var("SONATA_GPU_MIN_PHONEMES")
+            .ok()
+            .and_then(|value| value.parse().ok())
+            .unwrap_or(DEFAULT_GPU_MIN_PHONEMES),
+    )
+}
+
+fn create_directml_inference_session(model_path: &Path) -> Result<Session, ort::Error> {
+    let device_id = std::env::var("SONATA_DIRECTML_DEVICE_ID")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(0);
+    Session::builder()?
+        .with_parallel_execution(false)?
+        .with_memory_pattern(false)?
+        .with_execution_providers([
+            ort::execution_providers::DirectMLExecutionProvider::default()
+                .with_device_id(device_id)
+                .build()
+                .error_on_failure(),
+            ort::execution_providers::CPUExecutionProvider::default().build(),
+        ])?
         .commit_from_file(model_path)
 }
 
