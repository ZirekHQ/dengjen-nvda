#. Translators: label of a menu item
#: addon\globalPlugins\dengjen_tts_global_plugin\__init__.py:46
msgid "Dengjen &voice manager..."
msgstr "&Rêveberê dengên Dengjen..."

#. Translators: Dengjen's voice manager menu item help
#: addon\globalPlugins\dengjen_tts_global_plugin\__init__.py:48
msgid "Open the voice manager to preview, install or download dengjen voices"
msgstr "Ji bo pêşdîtin, sazkirin an daxistina dengên Dengjen rêveberê dengan veke"

#. Translators: message telling the user that no voice is installed
#: addon\globalPlugins\dengjen_tts_global_plugin\__init__.py:63
msgid ""
"No Dengjen voice was found.\n"
"You can preview and download voices from the voice manager.\n"
"Do you want to open the voice manager now?"
msgstr ""
"Tu dengê Dengjen nehat dîtin.\n"
"Tu dikarî dengan ji rêveberê dengan pêşdîtin û daxînî.\n"
"Ma tu dixwazî rêveberê dengan niha vekî?"

